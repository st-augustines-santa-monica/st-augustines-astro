---
import "@styles/site.css";
import HeadAssets from "@components/document/HeadAssets.astro";
import HeadMeta from "@components/document/HeadMeta.astro";
import type { PageMeta } from "@content/siteConfig";
import SiteHeader from "@components/navigation/SiteHeader.astro";

interface Props {
    id?: string;
    pageMeta?: PageMeta;
}

const { id, pageMeta } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <HeadMeta
            id={id}
            meta={pageMeta?.meta}
            openGraph={pageMeta?.openGraph}
        />
        <HeadAssets />
    </head>
    <body>
        <!-- <SiteHeader /> -->
        <main
            class:list={["page"]}
            data-page={id}
            id="main-content"
            tabindex="-1"
        >
            <slot />
        </main>
    </body>
</html>
