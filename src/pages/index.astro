---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import bgImage from "@assets/steeple-front-bluesky-wide.jpeg";
import logo from "@assets/Aug_Episcopal_Shield_Logo.png";

const title = "St. Augustine by-the-Sea";
const subtitle = "Episcopal Church in Santa Monica, CA";

const bulletinLink =
    "https://drive.google.com/file/d/1RFSGj2SgQHt7nhRNVOe0zjdjBABT3QCX/view?usp=sharing";
const livestreamLink = "https://www.youtube.com/@StAugustinebytheSea";

const contactLocation = "1227 Fourth Street, Santa Monica, CA 90401";
const contactEmail = "church@saint-augustine.org";
const contactPhone = "(310) 395-0977";
---

<BaseLayout id="home">
    <div class="landing">
        <div class="content-wrapper">
            <header class="header">
                <div class="image-wrapper">
                    <Image
                        alt="St. Augustine by-the-Sea logo."
                        class="logo"
                        loading="eager"
                        src={logo}
                        width={300}
                    />
                </div>
                <div class="text-wrapper | flow" data-tempo="2xs">
                    <h1>{title}</h1>
                    <p class="subtitle">{subtitle}</p>
                </div>
            </header>
            <div class="sections">
                <div class="section | rich-text">
                    <p>
                        Our website is currently under construction. For
                        pastoral emergencies, please call (310) 395-0977 or
                        email:{" "}
                        <a href=`mailto:${contactEmail}`>{contactEmail}</a>.
                    </p>
                </div>
                <div class="section">
                    <h2>Weekly Services</h2>
                    <div class="services | cluster">
                        <div class="flow" data-tempo="2xs">
                            <h3>Sundays</h3>
                            <ul>
                                <li>
                                    <strong>8:00 am</strong> – Rite I Holy Eucharist
                                </li>
                                <li>
                                    <strong>10:30 am</strong> – Rite II Holy Eucharist
                                </li>
                            </ul>
                        </div>
                        <div class="flow" data-tempo="2xs">
                            <h3>Wednesdays</h3>
                            <ul>
                                <li>
                                    <strong>8:30 am</strong> – Market Mass
                                </li>
                                <li>
                                    <strong>7:00 pm</strong> – Centering Prayer
                                </li>
                            </ul>
                        </div>
                        <div class="flow" data-tempo="2xs">
                            <h3>Nightsong</h3>
                            <ul>
                                <li>
                                    <strong>7:30 pm</strong> – 1st and 3rd Sundays
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="ctas cluster">
                        <a
                            class="button-link with-icon"
                            data-size="small"
                            data-theme="primary"
                            href={bulletinLink}
                            target="_blank"
                            >10:30 am Sunday Bulletin
                            <svg
                                aria-hidden="true"
                                height="16"
                                viewBox="0 0 640 640"
                                width="16"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M354.4 83.8C359.4 71.8 371.1 64 384 64L544 64C561.7 64 576 78.3 576 96L576 256C576 268.9 568.2 280.6 556.2 285.6C544.2 290.6 530.5 287.8 521.3 278.7L464 221.3L310.6 374.6C298.1 387.1 277.8 387.1 265.3 374.6C252.8 362.1 252.8 341.8 265.3 329.3L418.7 176L361.4 118.6C352.2 109.4 349.5 95.7 354.5 83.7zM64 240C64 195.8 99.8 160 144 160L224 160C241.7 160 256 174.3 256 192C256 209.7 241.7 224 224 224L144 224C135.2 224 128 231.2 128 240L128 496C128 504.8 135.2 512 144 512L400 512C408.8 512 416 504.8 416 496L416 416C416 398.3 430.3 384 448 384C465.7 384 480 398.3 480 416L480 496C480 540.2 444.2 576 400 576L144 576C99.8 576 64 540.2 64 496L64 240z"
                                ></path></svg
                            ></a
                        >
                        <a
                            class="button-link with-icon"
                            data-size="small"
                            data-theme="white"
                            href={livestreamLink}
                            target="_blank"
                            >10:30 am Sunday Live-Stream
                            <svg
                                aria-hidden="true"
                                height="16"
                                viewBox="0 0 640 640"
                                width="16"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M354.4 83.8C359.4 71.8 371.1 64 384 64L544 64C561.7 64 576 78.3 576 96L576 256C576 268.9 568.2 280.6 556.2 285.6C544.2 290.6 530.5 287.8 521.3 278.7L464 221.3L310.6 374.6C298.1 387.1 277.8 387.1 265.3 374.6C252.8 362.1 252.8 341.8 265.3 329.3L418.7 176L361.4 118.6C352.2 109.4 349.5 95.7 354.5 83.7zM64 240C64 195.8 99.8 160 144 160L224 160C241.7 160 256 174.3 256 192C256 209.7 241.7 224 224 224L144 224C135.2 224 128 231.2 128 240L128 496C128 504.8 135.2 512 144 512L400 512C408.8 512 416 504.8 416 496L416 416C416 398.3 430.3 384 448 384C465.7 384 480 398.3 480 416L480 496C480 540.2 444.2 576 400 576L144 576C99.8 576 64 540.2 64 496L64 240z"
                                ></path></svg
                            ></a
                        >
                    </div>
                </div>
            </div>
            <footer class="footer | cluster">
                <p>{contactLocation}</p>
                <p><strong>Email: </strong>{contactEmail}</p>
                <p><strong>Phone: </strong>{contactPhone}</p>
            </footer>
        </div>
        <div class="overlay"></div>
        <Image
            alt=""
            class="bg-image"
            loading="eager"
            src={bgImage}
            width={2400}
        />
    </div>
</BaseLayout>

<style>
    .landing {
        max-height: 100dvh;
        overflow-y: scroll;
    }

    .content-wrapper {
        z-index: 1;
        color: white;
    }

    .overlay {
        position: absolute;
        z-index: 0;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgb(0 0 0 / 65%),
            rgb(0 0 0 / 95%) 75%
        );
    }

    .bg-image {
        opacity: 1;
        mix-blend-mode: normal;
        z-index: -1;
    }

    .logo {
        border-radius: 999px;
        width: 8rem;
        height: 8rem;
    }

    .subtitle {
        font-size: var(--step-1);
    }

    .services {
        --cluster-align: flex-start;
        --cluster-space: var(--space-xl);
        margin-block-start: var(--space-m);
        row-gap: var(--space-l);
    }

    .ctas {
        margin-block-start: var(--space-m);
    }

    .header {
        display: flex;
        gap: var(--space-m);
        align-items: center;
        margin-block-start: var(--space-3xl);
    }

    .footer {
        --cluster-align: flex-start;
        margin-block-start: 8rem;
        padding-block-end: 1rem;
        text-align: center;
        font-size: var(--step--1);
        row-gap: 0.5rem;
    }

    @media (max-width: 768px) {
        .header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
